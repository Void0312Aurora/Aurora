{
  "name": "dsh-vscode",
  "displayName": "DeepSeek Harness Panel",
  "description": "VS Code panel hosting the full DeepSeek Harness GUI: a managed dsh web per window, the complete client stack in a webview, and editor-side integrations",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "publisher": "deepseek-ai",
  "main": "./dist/extension.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dshSidebar",
          "title": "DeepSeek Harness",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "dshSidebar": [
        {
          "id": "dsh.sidebar",
          "name": "DeepSeek Harness",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.focus",
        "title": "DeepSeek Harness: Focus Sidebar",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.showChat",
        "title": "DeepSeek Harness: Show Conversation",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.showSessions",
        "title": "DeepSeek Harness: Show Sessions",
        "icon": "$(history)"
      },
      {
        "command": "dsh.restartServer",
        "title": "DeepSeek Harness: Restart Server",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.showChat",
          "when": "view == dsh.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "dsh.showSessions",
          "when": "view == dsh.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "dsh.restartServer",
          "when": "view == dsh.sidebar",
          "group": "1_dsh"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown && vite build --config webview/vite.config.ts",
    "build:host": "tsdown",
    "build:webview": "vite build --config webview/vite.config.ts",
    "deploy:closure": "node -e \"require('node:fs').rmSync('deploy',{recursive:true,force:true})\" && pnpm --filter dsh-vscode-closure deploy --prod --config.node-linker=hoisted --config.inject-workspace-packages=true --config.allow-unused-patches=true --config.strict-dep-builds=false deploy && node -e \"for (const f of ['pnpm-lock.yaml','pnpm-workspace.yaml']) require('node:fs').rmSync('deploy/'+f,{force:true})\"",
    "package": "pnpm -w run build:lib && pnpm -w run build:web && pnpm run deploy:closure && pnpm run build && node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-process-tree": "workspace:^",
    "@deepseek-ai/dsh-web-launcher": "workspace:^",
    "@deepseek-ai/dsh-user-questions": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-client-ui-commands": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-cordis": "workspace:^",
    "@deepseek-ai/dsh-client-ui-deliverables": "workspace:^",
    "@deepseek-ai/dsh-client-ui-goal": "workspace:^",
    "@deepseek-ai/dsh-client-ui-jobs": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-message-feedback": "workspace:^",
    "@deepseek-ai/dsh-client-ui-model-selection": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-models": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugin-inventory": "workspace:^",
    "@deepseek-ai/dsh-client-ui-permission-presets": "workspace:^",
    "@deepseek-ai/dsh-client-ui-plan": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:^",
    "@deepseek-ai/dsh-client-ui-user-questions": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workflow-run": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-ui-skill": "workspace:^",
    "@deepseek-ai/dsh-client-ui-subagent": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@deepseek-ai/dsh-client-ui-trajectory": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:^",
    "@deepseek-ai/dsh-cordis-client-runner": "workspace:^",
    "@deepseek-ai/dsh-session-log-export": "workspace:^",
    "@deepseek-ai/dsh-typert-registry": "workspace:^",
    "@deepseek-ai/dsh-client-ui-input-trigger": "workspace:^",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/vscode": "^1.100.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/vsce": "^3.6.2",
    "playwright": "^1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
